# pjournal-pico: 合并 read_pico 板级配置 + pjournal 的 BLE/WiFi/HTTP 需求。
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16M.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# read_pico 板级调优：flash 与 PSRAM 共用 120MHz 时钟域（见 read_pico sdkconfig.defaults 注释）。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# 默认 16384：小于该阈值的分配强制走内部 RAM。阅读器解析一章要造出海量几百字节~几 KB 的
# std::string/TextBlock/ParsedText，全部落在内部 RAM 会把 32KB 的 DMA 保留区吃光，
# 于是 SDMMC 的弹跳缓冲分配失败（allocate_dma_buf: not enough mem）、读写直接报错。
# 降到 1024 仍不够：写作模式实测打字时内部堆掉到只剩 1.2KB 空闲、最大连续块 544B
# （内部 242KB 里已分配 234KB），此时任何一次小块分配失败都会让 libc 直接 abort
# ——实际崩溃点是蓝牙重连时 loadPairedDevices() 的 fopen/fgets 给 FILE 分配互斥量失败。
# 设为 0：所有默认分配优先 PSRAM（PSRAM 还空着 4.7MB），PSRAM 失败才回退内部堆。
# 真正需要内部/DMA 的缓冲都走显式 MALLOC_CAP_INTERNAL|MALLOC_CAP_DMA，不受此项影响
# （epdiy 行队列、LCD 逐行 DMA 缓冲、SDMMC 弹跳缓冲均已显式指定）。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# U盘模式：TinyUSB MSC。运行 U 盘模式时 TinyUSB 会把 USB PHY 从 USJ 切到 OTG，
# GPIO19/20(D-/D+) 归 OTG 用，USJ 控制台自然断开；退出后恢复。
# / U-disk mode: TinyUSB MSC. While it runs, TinyUSB switches the USB PHY from USJ
# to OTG (GPIO19/20 = D-/D+); the USJ console disconnects and returns on exit.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# WiFi（pjournal 的 STA 网络：WebDAV/Flomo/Deepseek/NTP）
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# WiFi 的静态 RX/TX 缓冲**必须落在内部 DMA RAM**（PSRAM 走不了），本机内部 RAM
# 到阅读模式初始化时只剩 ~30KB、最大连续块 ~29KB，用默认值（RX 6 / TX 16 / cache 32）
# 时 esp_wifi_init 直接报 `esf_buf_setup_static: alloc eb fail` 而起不来。
# 我们的网络用途只有 OPDS/WebDAV/Flomo/NTP 这类小 HTTP，把各池压到这个量足够。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# mbedTLS 默认所有动态分配都走**内部** RAM。本机进阅读模式后内部 RAM 只剩 ~20KB，
# 而 TLS 的 in/out 缓冲就 16KB+4KB（非对称内容长度），mbedtls_ssl_setup 直接
# 返回 -0x008D(MBEDTLS_ERR_SSL_ALLOC_FAILED = PSA_ERROR_INSUFFICIENT_MEMORY)，
# HTTPS 全线连不上。改用 PSRAM（本机 8MB，余 5MB+）。安全性提示：除非开了 flash
# 加密，PSRAM 内容不上加密总线；个人阅读设备可接受。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ── 关掉 mbedTLS 的硬件 SHA / 硬件 AES（保留硬件 MPI）────────────────────────
# 现场：生成 Flomo Token 报「登录失败 / 网络连接失败」，串口上是
#     E crypto_shared_gdma: Failed to acquire DMA channel, Err=257
#     E esp-sha:            esp_sha_dma_start failed, no DMA channel available
#     E esp-tls-mbedtls:    mbedtls_ssl_handshake returned -0x0093
# Err=257 = ESP_ERR_NO_MEM —— **不是通道被占满，是分配不出通道对象本身**。
# 逐行核对 IDF v6.1 源码后，硬件加解密在 TLS 的每一步都要向「能落 DMA 的内部 RAM」
# 要一小块，而这块池子在本机开机几百毫秒后就被打成了碎片（实测两个 DMA 内部堆区
# 剩 788 / 676 字节、**最大连续块只有 24 字节**，长期稳定不是偶发）：
#   · 纯软件路径（ROM MD5 / esp_rom_md5）：不碰 DMA，一直好使。
#   · 所有 SHA 都走 PSA —— esp_sha.c:71 的 esp_sha() 只是 psa_hash_compute() 的薄壳；
#     而 PSA 的 esp_sha256 驱动**每一次 esp_sha_hash_setup() 都分配 124 字节、
#     caps 必须是 MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL**（psa_crypto_driver_esp_sha.c:140/161/189）。
#     分配失败正是日志里那 5 条 `ALLOC FAILED size=124 caps=0x80c in heap_caps_malloc`。
#   · 硬件 AES 一样：每次 CBC/GCM 运算都现造 DMA 描述符表，同样是
#     MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL（esp_aes_dma_core.c:462，用完即 free），
#     外加对齐用的临时缓冲（:471/:493）。
#   · 输入超过阈值（SHA >256 字节、AES >128/512 字节）还得再要一对共享 GDMA 通道，
#     通道对象是 124 字节的 heap_caps_calloc(…, MALLOC_CAP_INTERNAL|8BIT|DMA)
#     （gdma.c:100），失败后驱动每 100ms 重试、连试 1 秒才认输 —— 这 1 秒里
#     WiFi 管理帧被一起挤丢（日志 `wifi:m f null` 的时间窗就是它）。
# 结论：硬件 SHA/AES 的**每一次操作**都要从这口碎片池里要一小块，这是预热/预分配
# 绕不过去的（通道能预热，逐次分配的上下文和描述符不能）。所以让 TLS 的密码学根本
# 不去碰这口池子，改用软件实现 —— 这是 IDF 支持的自包含配置，不依赖堆的实时状态，
# 也不动 WiFi/蓝牙的取舍。
# 代价（评估过，可接受）：本机每次握手只哈希几 KB（<10ms），AES 只用在 WebDAV/词典
# 这类几 MB 传输上（软件 AES 约 2~4MB/s，多花几秒）。RSA/ECC 的证书验签仍走硬件 MPI
# —— bignum 端口全文件零分配（只 include 了 malloc.h），不吃这口池子，没必要关。
# 若日后要换回硬件：先让这口池在 WiFi+蓝牙同时活动时也留得下连续小块（真正的根是
# 蓝牙/WiFi 吃掉的内部 RAM 总量），再删掉下面两行。**注意别指望
# CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST** —— 本机 CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# 让 malloc() 本来就先走 PSRAM（heap_caps.c:117：阈值 0 → 所有非零大小都走
# MALLOC_CAP_SPIRAM），而 Bluedroid 的 osi_malloc/osi_calloc 就是 malloc/calloc ——
# 那条开关只是换个写法表达同一种偏好；它也管不到控制器（控制器内存 caps 写死在
# controller/esp32c3/bt.c 的 BLE_CONTROLLER_MALLOC_CAPS，无任何 PSRAM 选项）。
# 真正能让出内部 RAM 的是下面那条 BT_CTRL_BLE_MAX_ACT。
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# HTTP（文件管理服务器 + WebDAV/Flomo/Deepseek 客户端）
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 板级：epdiy 行队列改用 8 行小队列（read_pico 组件 Kconfig 选项）。
# 32 行队列 ×2 线程 ≈ 19KB 内部 DMA RAM，8 行省下约 14KB；本机要同时养 epdiy、
# Bluedroid 与 WiFi 三份内部 RAM，必须挤出来。见 read_pico Kconfig 注释。
CONFIG_READ_PICO_EPD_SMALL_FEED_QUEUE=y

# BLE（pjournal 的 BLE HID 键盘主机）
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# 控制器为"活动"(连接/扫描/同步/广播)预分配的实例数，Kconfig 原文："Each instance
# needs to consume 828 bytes"。这台机器只当一把 BLE HID 键盘的 host：活动数最多是
# 「扫描」+「已建连接」两种，而 bt_keyboard.cpp 的 connect_task 在 gattc_open 之前
# 先 stop_ext_scan（并等 500ms），实际不会同时用到两个 —— 取 2 是留一点余量，
# 别取 1（范围下限本来就是 1，但踩线会让键盘连不上，症状难定位）。
# 6 → 2 从内部 RAM 让出 4×828 = 3312 字节，而且这是控制器直接要的
# MALLOC_CAP_INTERNAL|MALLOC_CAP_DMA，正是逼死硬件 SHA/AES 的那口池。
# EFF 是控制器实际读的那个值，它 default 跟 MAX_ACT，但 sdkconfig 里存着旧值不会自己跟，
# 所以要一起写。
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_MAX_ACT_EFF=2
# 键盘 HID 报告(键盘+consumer+system+vendor)的 CCC 通知注册数；默认 5 不够，
# 会报 "Max Notification Reached" 导致连上后收不到按键。
CONFIG_BT_GATTC_NOTIF_REG_MAX=20

# ESP32-S3 的 RTC fast RAM(8KB @0x600FE000) 只登记 MALLOC_CAP_INTERNAL、DMA 不可达，
# 而 SDMMC 驱动仅按地址对齐就决定直接 DMA，会把落在该区的 fread/fwrite 缓冲写坏
# （表现为 EPUB 章节解析中途报错、正文空白）。关闭它，避免这块兜底区被当普通堆用。
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
